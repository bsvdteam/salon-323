# Supabase — Werte findest du im Supabase-Dashboard unter:
# Project Settings -> API
# Diese Datei ist eine VORLAGE (wird eingecheckt). Echte Werte kommen in .env.local!
NEXT_PUBLIC_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=dein-anon-public-key
# service_role (im neuen UI: "Secret key") — SERVER-geheim, niemals NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=dein-service-role-key

# Signiert die Session-Cookies (HMAC). Lokal generieren mit:
#   openssl rand -hex 32
SESSION_SECRET=

# Google Kalender (OAuth) — Werte aus der Google Cloud Console:
#   APIs & Dienste -> Anmeldedaten -> OAuth-Client-ID (Webanwendung)
# GOOGLE_REFRESH_TOKEN kommt erst nach dem Einmal-Login (/api/google/auth).
# Alle Google-Werte sind SERVER-geheim -> niemals NEXT_PUBLIC_.
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=dein-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/google/callback
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
GOOGLE_TZ=Europe/Zurich
