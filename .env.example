# Supabase — Werte findest du im Supabase-Dashboard unter:
# Project Settings -> API
# Diese Datei ist eine VORLAGE (wird eingecheckt). Echte Werte kommen in .env.local!
NEXT_PUBLIC_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=dein-anon-public-key
# service_role (im neuen UI: "Secret key") — SERVER-geheim, niemals NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=dein-service-role-key

# Signiert die Session-Cookies (HMAC). Lokal generieren mit:
#   openssl rand -hex 32
SESSION_SECRET=

# Google Kalender (OAuth) — Werte aus der Google Cloud Console:
#   APIs & Dienste -> Anmeldedaten -> OAuth-Client-ID (Webanwendung)
# GOOGLE_REFRESH_TOKEN kommt erst nach dem Einmal-Login (/api/google/auth).
# Alle Google-Werte sind SERVER-geheim -> niemals NEXT_PUBLIC_.
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=dein-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/google/callback
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
GOOGLE_TZ=Europe/Zurich

# Apple Wallet (Mitglieds-/Terminkarte) — nur EINMALIG im Apple Developer Portal:
#   1. Identifiers -> Pass Type IDs -> neu: z.B. pass.ch.salon15.member
#   2. Dafür ein Zertifikat erstellen, in Keychain importieren und als .p12
#      exportieren (mit Passwort) -> als signerCert.p12 ablegen
#   3. Apple WWDR-Zwischenzertifikat laden (apple.com/certificateauthority/)
#      -> als wwdr.pem (oder wwdr.cer) ablegen
# Die .p12-Datei NIE ins Repo (enthält den privaten Schlüssel) — in einen Ordner
# AUSSERHALB des Repos legen und hierher zeigen. Team ID: Membership-Seite.
APPLE_WALLET_PASS_TYPE_ID=pass.ch.salon15.member
APPLE_WALLET_TEAM_ID=DEINE_TEAM_ID
APPLE_WALLET_CERT_PASSWORD=dein-p12-export-passwort
APPLE_WALLET_ORG_NAME=Salon 15
# Zertifikate ENTWEDER lokal als Ordner (Dev) ODER als Base64 (Vercel/Serverless).
#  a) Lokal: Ordner ausserhalb des Repos mit signerCert.p12 + wwdr.cer
APPLE_WALLET_CERT_DIR=/absoluter/pfad/ausserhalb/repo/salon15-wallet
#  b) Produktion (Vercel): .p12 und WWDR als Base64 (kein Dateisystem).
#     Erzeugen z.B. mit:  base64 -i signerCert.p12   /   base64 -i wwdr.cer
APPLE_WALLET_SIGNER_P12_BASE64=
APPLE_WALLET_WWDR_BASE64=
# Erst für Phase 2 (automatische Updates per Push) — vorerst leer lassen:
APPLE_WALLET_WEB_SERVICE_URL=
